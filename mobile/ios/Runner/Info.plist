<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ellipse records your location when you clock in, clock out, or update field-work status.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With your consent, Ellipse records your route during field work so your organization can verify visits. Tracking runs only while you are on field work and stops automatically at your end-of-work time.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>With your consent, Ellipse records your route during field work and stops automatically at your end-of-work time.</string>
	<key>GOOGLE_MAPS_API_KEY</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Ellipse Desk</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Ellipse Desk</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>location</string>
			<string>fetch</string>
		</array>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Ellipse Desk needs access to your photo library so you can attach images to messages.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Ellipse Desk needs permission to save images you attach or capture for messages.</string>
		<key>NSCameraUsageDescription</key>
		<string>Ellipse Desk needs camera access so you can take photos to attach to messages.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Ellipse Desk needs microphone access when you record video attachments for messages.</string>
		<key>NSAppleMusicUsageDescription</key>
		<string>Ellipse Desk needs access to your media library so you can attach audio files to messages.</string>
	</dict>
</plist>
